{
  "name": "mypage2026",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "wrangler types && tsc -b && vite build && node scripts/prerender.js",
    "lint": "oxlint src worker vite.config.ts",
    "format": "oxfmt src worker vite.config.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "dev:api": "wrangler dev --port 8787",
    "photos:import": "node scripts/sync-photos.mjs import",
    "photos:pull": "node scripts/sync-photos.mjs pull",
    "photos:push": "node scripts/sync-photos.mjs push"
  },
  "dependencies": {
    "glaku": "^0.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.132.0"
  }
}
